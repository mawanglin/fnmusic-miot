#!/bin/bash
# 升级前检查（与 install_init 对齐）。
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

# Node.js / Python / ffmpeg 已随包附带（<appdir>/opt），只做自检，不再要求应用中心安装。
NODE_BIN="$(fnmusic_miot_find_node)"
# 此阶段应用文件可能尚未落盘（opt/ 不存在）：找得到就自检，找不到放行，
# 由文件落盘后的 install_callback / upgrade_callback 做最终硬校验。
if [ -n "${NODE_BIN}" ]; then
    NODE_MAJOR="$(fnmusic_miot_node_major "${NODE_BIN}")"
    if [ "${NODE_MAJOR}" -lt 18 ]; then
        fnmusic_miot_fail "Node.js 无法运行或版本过低（${NODE_BIN}）：安装包与本机架构不符，请换用对应架构（x86/arm）的 fpk"
    fi
fi

# Python 已随包附带（<appdir>/opt/python），无需系统自带。

DB_DIR="${FNMUSIC_MUSIC_DB_DIR:-/usr/local/apps/@appdata/trim.music/db}"
[ -d "${DB_DIR}" ] || fnmusic_miot_fail "未检测到飞牛音乐曲库（${DB_DIR}）：请先安装并启动飞牛音乐（trim.music）"

# 可选增强 fnmusic-ext：只记录状态，不阻断升级。
if command -v curl >/dev/null 2>&1 \
   && curl -fsS -m 2 --unix-socket /var/run/trim_music.socket \
        http://localhost/_ext/healthz >/dev/null 2>&1; then
    echo "[fnmusic-miot] 可选增强 fnmusic-ext 已就绪：在线榜单/在线音源可用" >> "${FNMUSIC_MIOT_LOG}" 2>&1
else
    echo "[fnmusic-miot] 未检测到 fnmusic-ext：以纯本地曲库模式运行（不影响升级）" >> "${FNMUSIC_MIOT_LOG}" 2>&1
fi

# 新包覆盖 repo 之前先把容器版数据搬出来（token / storage.json）。
fnmusic_miot_migrate_legacy_data

exit 0
