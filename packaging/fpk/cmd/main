#!/bin/bash
# App Center start/stop/status for fnmusic-miot（原生部署：systemd 单元承载）。
#   start  = 写单元、enable、restart，并等到 8775/8776 都就绪
#   stop   = 停单元并清理网关 socket
#   status = exit 0 running / exit 3 stopped
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

case "${1:-}" in
    start)
        [ -n "${MIOT_REPO_DIR}" ] || fnmusic_miot_fail "应用文件缺失，请卸载后重新安装"
        [ -f "${MIOT_REPO_DIR}/.env" ] || fnmusic_miot_fail "尚未完成安装配置（.env 缺失），请卸载后重新安装"

        NODE_BIN="$(fnmusic_miot_find_node)"
        if [ -z "${NODE_BIN}" ]; then
            fnmusic_miot_fail "未找到随包 Node.js 运行时：安装包不完整或架构不符，请重新下载对应架构（x86/arm）的 fpk"
        fi
        NODE_MAJOR="$(fnmusic_miot_node_major "${NODE_BIN}")"
        if [ "${NODE_MAJOR}" -lt 18 ]; then
            fnmusic_miot_fail "Node.js 版本过低（${NODE_BIN} 为 v${NODE_MAJOR}）：请安装 v18 及以上版本"
        fi

        fnmusic_miot_write_unit "${NODE_BIN}" || fnmusic_miot_fail "写入 systemd 单元失败（${MIOT_UNIT_PATH}）"
        systemctl enable "${MIOT_UNIT_NAME}" >> "${FNMUSIC_MIOT_LOG}" 2>&1 || true
        if ! fnmusic_miot_run_logged systemctl restart "${MIOT_UNIT_NAME}"; then
            fnmusic_miot_fail_from_log "启动失败"
        fi
        if ! fnmusic_miot_wait_ready 25; then
            journalctl -u "${MIOT_UNIT_NAME}" -n 15 --no-pager >> "${FNMUSIC_MIOT_LOG}" 2>&1 || true
            fnmusic_miot_fail_from_log "启动超时：控制层或控制台未在 25 秒内就绪"
        fi
        exit 0
        ;;
    stop)
        systemctl stop "${MIOT_UNIT_NAME}" >> "${FNMUSIC_MIOT_LOG}" 2>&1 || true
        rm -f "${MIOT_SOCKET}" 2>/dev/null || true
        exit 0
        ;;
    status)
        if fnmusic_miot_unit_active; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
