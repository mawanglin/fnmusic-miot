#!/bin/bash
# 卸载前：停用并移除 systemd 单元与网关 socket。
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

# 数据去留由卸载向导的开关决定，在 uninstall_callback 里执行：默认保留在 appdata，
# 不再额外复制一份到 <卷>/fnmusic-miot-data（旧版会这么做，只是多占空间）。

# 先摘单元再删文件：应用中心随后会删掉整个应用目录。
fnmusic_miot_remove_unit

# 容器版升级上来的，可能还残留容器与镜像。
if command -v docker >/dev/null 2>&1; then
    docker rm -f fnmusic-miot >/dev/null 2>&1 || true
    docker rmi fnmusic-miot:latest >/dev/null 2>&1 || true
fi

exit 0
