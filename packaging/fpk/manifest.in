appname               = fnmusic-miot
version               = @VERSION@
display_name          = Miot小爱音箱
desc                  = 小米/红米智能音箱独立控制层：设备管理、语音口令、播放控制、DLNA 投放。原生运行，不使用 Docker；控制台与桌面网关经应用自带 socket 接入。依赖飞牛音乐（trim.music）；Node.js、Python、ffmpeg 已随包附带（分 x86 / arm 两个包），无需另装；fnmusic-ext 为可选增强，安装后可用在线榜单/在线音源，未安装时自动降级为纯本地曲库模式。
platform              = @PLATFORM@
source                = thirdparty
maintainer            = Cob
maintainer_url        = https://github.com/mawanglin/fnmusic-miot
os_min_version        = 1.2.0
desktop_uidir         = ui
desktop_applaunchname = fnmusic-miot.main
checkport             = false
micro_app             = true
